# Environment
.venv/
# uv's interpreter and wheel cache, kept here rather than in the inode-quotaed
# $HOME -- see scripts/setup_env.sh section 0.
.uv/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Data and experiment output (large, regenerated by scripts)
data/
modelstore/
evalstore/
wandblogs/
outputs/
figures/
lightning_logs/
*.ckpt

# Generated statistics artefacts (rebuilt by `make stats`)
oceanarches/stats/*.nc
oceanarches/stats/*.pt
oceanarches/stats/*.json

# SLURM
slurm-*.out
logs/

# Editors / OS
.vscode/
.idea/
.DS_Store
